{
	"name": "dev-portfolio-sveltekit",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow bun",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write --plugin-search-dir=. **/*.{html,mjs,ts,json,svelte,css} --ignore-path .gitignore"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.19.15",
		"bits-ui": "1.3.0",
		"clsx": "^2.1.1",
		"embla-carousel-auto-scroll": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"lucide-svelte": "^0.475.0",
		"posthog-js": "^1.362.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.54.0",
		"svelte-awesome-icons": "^2.0.2",
		"svelte-check": "^4.4.5",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^0.3.1",
		"tailwindcss": "^4.2.2",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^6.4.1",
		"vite-imagetools": "^7.1.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.2.8",
		"gsap": "^3.14.2",
		"mode-watcher": "^0.4.1"
	}
}
